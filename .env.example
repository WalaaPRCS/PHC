# Database credentials (replace before deployment)
POSTGRES_DB=phc
POSTGRES_USER=phc_app
POSTGRES_PASSWORD=CHANGE_TO_A_LONG_RANDOM_PASSWORD

# First system administrator; created once on first startup
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_TO_A_LONG_RANDOM_PASSWORD
ADMIN_DISPLAY_NAME=مدير النظام

# Random value of at least 32 characters; keep private
SESSION_SECRET=CHANGE_TO_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS

# Generate two separate 32-byte keys with: openssl rand -hex 32
DATA_ENCRYPTION_KEY=REPLACE_WITH_64_HEX_CHARACTERS
DATA_LOOKUP_KEY=REPLACE_WITH_A_DIFFERENT_64_HEX_KEY

NODE_ENV=production
PORT=8080
